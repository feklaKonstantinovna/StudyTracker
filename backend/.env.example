# Скопируй этот файл в .env и заполни значения

# Сервер
PORT=3001

# JWT — придумай любую длинную случайную строку
JWT_SECRET=super-secret-key-change-me-please-12345

# Email (для отправки magic link)
# Если у тебя Gmail — включи "Пароли приложений" в настройках Google аккаунта
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=твой@gmail.com
SMTP_PASS=пароль_приложения_google
EMAIL_FROM=StudyFlow <твой@gmail.com>

# URL приложения (где открывается HTML-файл)
# Если локально — оставь так
APP_URL=http://localhost:3001

# Telegram Bot
# Создай бота через @BotFather в Telegram, получи токен
TELEGRAM_BOT_TOKEN=1234567890:AAbbccddee...

# Время ежедневного напоминания (24ч формат, UTC+3)
REMINDER_HOUR=9
REMINDER_MINUTE=0
